# Copied to /etc/kiosk-monitor/kiosk-monitor.env by install.sh. The API token is NOT in here:
# it lives in /etc/kiosk-monitor/api-token (same value as KIOSK_API_TOKEN in Laravel's .env).
KIOSK_REVERB_HOST=order.larsfixt.nl
KIOSK_REVERB_PORT=443
# Public Reverb app key (REVERB_APP_KEY), the same one the browser uses
KIOSK_REVERB_APP_KEY=
KIOSK_STATUS_URL=https://keuken.pinoke.net/api/kiosk/tv-status
# Where the status for the TV control page is sent; defaults to .../kiosk/heartbeat next to KIOSK_STATUS_URL
# KIOSK_HEARTBEAT_URL=https://keuken.pinoke.net/api/kiosk/heartbeat
