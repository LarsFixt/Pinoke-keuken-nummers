# Copied to /etc/kitchen-tickets/kitchen-tickets.env by install.sh.
# Edit, then: sudo systemctl restart kitchen-tickets
# The shared secret is NOT in here: it lives in /etc/kitchen-tickets/secret.

# 1 = observe mode: read and archive tickets, send nothing to the app (safe first test).
#     Check with: sudo kitchen-tickets-report
# 0 = live: tickets go to the app. Only after the app with the ticket API is deployed.
TICKETS_DRY_RUN=1

# Interface plugged into the UniFi mirror port (gets no IP address)
TICKETS_IFACE=eth0
# Kitchen printer and its raw print port
TICKETS_PRINTER_IP=172.220.230.190
TICKETS_PORT=9100

# Laravel endpoint (https only) and the key id, must match TICKET_BRIDGE_KEY_ID in Laravel's .env
TICKETS_API_URL=https://keuken.pinoke.net/api/kitchen-tickets
TICKETS_KEY_ID=bridge-1

TICKETS_OCR_LANG=nld
TICKETS_ARCHIVE_DAYS=30
